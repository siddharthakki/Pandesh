# Keep executable shell scripts usable from WSL even when the repository is checked out on Windows.
*.sh text eol=lf

# This source intentionally contains literal NUL fingerprint delimiters.
src/coding/ChangeScopeReconciliation.ts diff

# Git hooks must keep LF line endings to run under Git for Windows.
.githooks/* text eol=lf

# Node scripts with a shebang line must keep LF (a CR after "node" breaks the import under vitest/Node on Windows checkouts).
scripts/panda-bridge/*.mjs text eol=lf
