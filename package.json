{
  "name": "ollama-agent",
  "displayName": "KarkeDikha",
  "description": "Local AI coding agent powered by Ollama with tool execution, checkpoints, approval flows, observability, diagnostics, and bounded external control",
  "version": "0.1.2",
  "publisher": "ollama-agent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/siddharthakki/ollama-agent.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
