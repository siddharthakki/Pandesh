    "configuration": {
      "title": "KarkeDikha",
      "properties": {
        "ollama-agent.model": {
          "type": "string",
          "default": "",
          "description": "Fallback model when no specific model is matched by the router. Leave empty for Auto: KarkeDikha discovers installed models and selects a viable one automatically."
        },
        "ollama-agent.uiV2Enabled": {
          "type": "boolean",
          "default": false,
          "description": "Load the React-based UI v2 chat shell instead of the legacy webview (Phase 1, strangler migration)."
        },
        "ollama-agent.agentModel": {
          "type": "string",
          "default": "",
          "description": "Model used for autonomous agent tasks (tool calling, editing, planning). Leave empty for Auto: any installed model with tool-calling capability is discovered and selected automatically."
        },
        "ollama-agent.autocompleteModel": {
          "type": "string",
          "default": "qwen2.5-coder:1.5b",
          "description": "Fast small model used exclusively for inline autocomplete. Not used for agent or chat."
        },
        "ollama-agent.editModel": {
          "type": "string",
          "default": "",
          "description": "Model used for targeted file edits and patches. Leave empty for Auto: an installed model is discovered and selected automatically."
        },
        "ollama-agent.reviewerModel": {
          "type": "string",
          "default": "",
          "description": "Model used for code review and validation. Leave empty for Auto: an installed model is discovered and selected automatically."
        },
        "ollama-agent.codingModel": {
          "type": "string",
          "default": "",
          "description": "Model used for coding tasks (writing, fixing, refactoring code). Leave empty for Auto: an installed model is discovered and selected automatically."
        },
        "ollama-agent.codingFallbackModel": {
          "type": "string",
          "default": "",
          "description": "Fallback coding model if the primary coding model is unavailable. Leave empty for Auto: an installed model is discovered and selected automatically."
        },
        "ollama-agent.chatModel": {
          "type": "string",
          "default": "",
          "description": "Model used for general conversation and reasoning. Leave empty for Auto: an installed model is discovered and selected automatically."
        },
        "ollama-agent.visionModel": {
          "type": "string",
          "default": "qwen3-vl:30b",
          "description": "Model used automatically when images or documents are attached"
        },
        "ollama-agent.embeddingModel": {
          "type": "string",
          "default": "nomic-embed-text",
          "description": "Model used for embeddings and RAG"
        },
        "ollama-agent.systemOne.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Experimental: send each turn to a LOCAL System-One decision provider for shadow comparison with KarkeDikha's own routing. Never changes routing. Loopback endpoints only."
        },
        "ollama-agent.systemOne.mode": {
          "type": "string",
          "enum": [
            "off",
            "shadow"
          ],
          "default": "shadow",
          "description": "System-One mode. Only 'shadow' (record-and-compare) is supported; 'off' disables it. Requires ollama-agent.systemOne.enabled."
        },
        "ollama-agent.systemOne.provider": {
          "type": "string",
          "default": "ollaya",
          "description": "System-One provider implementation to use. Currently only 'ollaya' (a local Ollaya/Laya/Jev-compatible server) is supported."
        },
        "ollama-agent.systemOne.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8771",
          "description": "Loopback URL of the local System-One provider (127.0.0.1 / localhost only)."
        },
        "ollama-agent.systemOne.model": {
          "type": "string",
          "default": "",
          "description": "Optional model id to request from the System-One provider. Empty uses the provider's own default."
        },
        "ollama-agent.systemOne.timeoutMs": {
          "type": "number",
          "default": 800,
          "minimum": 100,
          "maximum": 5000,
          "description": "Per-request timeout for the System-One provider. On timeout or error KarkeDikha behaves as if System-One were off."
        },
        "ollama-agent.laya.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Deprecated: use ollama-agent.systemOne.enabled. Kept for backward compatibility; used only when systemOne.enabled is not explicitly set."
        },
        "ollama-agent.laya.mode": {
          "type": "string",
          "enum": [
            "off",
            "shadow"
          ],
          "default": "shadow",
          "description": "Deprecated: use ollama-agent.systemOne.mode. Kept for backward compatibility; used only when systemOne.mode is not explicitly set."
        },
        "ollama-agent.laya.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8771",
          "description": "Deprecated: use ollama-agent.systemOne.endpoint. Kept for backward compatibility; used only when systemOne.endpoint is not explicitly set."
        },
        "ollama-agent.laya.timeoutMs": {
          "type": "number",
          "default": 800,
          "minimum": 100,
          "maximum": 5000,
          "description": "Deprecated: use ollama-agent.systemOne.timeoutMs. Kept for backward compatibility; used only when systemOne.timeoutMs is not explicitly set."
        },
        "ollama-agent.apiBase": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Inference backend base URL. Ollama default: http://localhost:11434. LM Studio default: http://localhost:1234."
        },
        "ollama-agent.searxngUrl": {
          "type": "string",
          "default": "",
          "description": "Optional local SearXNG endpoint for approved web research. Empty disables research."
        },
        "ollama-agent.providerType": {
          "type": "string",
          "enum": [
            "ollama",
            "openai-compatible"
          ],
          "enumDescriptions": [
            "Ollama native API (/api/chat). Recommended for local Ollama installs.",
            "OpenAI-compatible API (/v1/chat/completions). Use for LM Studio or any OpenAI-format endpoint."
          ],
          "default": "ollama",
          "description": "Inference provider type. Set to 'openai-compatible' for LM Studio or generic OpenAI endpoints."
        },
        "ollama-agent.modelRoutingPolicy": {
          "type": "string",
          "enum": [
            "local-only",
            "local-first-cloud-fallback"
          ],
          "enumDescriptions": [
            "Only the configured local provider may receive repository or task context.",
            "Try the local provider first. If a local run fails for a recoverable runtime reason, the configured cloud fallback endpoint may receive the same repository/task context for exactly one retry."
          ],
          "default": "local-only",
          "markdownDescription": "Repository-data boundary for automatic model routing. `local-first-cloud-fallback` explicitly permits sending repository and task context to `#ollama-agent.cloudFallbackApiBase#`. It has no effect until that endpoint, `#ollama-agent.cloudFallbackModel#` and the API key (command: *KarkeDikha: Set Cloud Fallback API Key*) are all configured."
        },
        "ollama-agent.cloudFallbackApiBase": {
          "type": "string",
          "default": "",
          "markdownDescription": "OpenAI-compatible base URL used only for the bounded cloud fallback. Ignored unless `#ollama-agent.modelRoutingPolicy#` is `local-first-cloud-fallback`."
        },
        "ollama-agent.cloudFallbackModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model requested from `#ollama-agent.cloudFallbackApiBase#` during a bounded cloud fallback. Ignored unless `#ollama-agent.modelRoutingPolicy#` is `local-first-cloud-fallback`."
        },
        "ollama-agent.orcaRouterApiBase": {
          "type": "string",
          "default": "https://api.orcarouter.ai/v1",
          "markdownDescription": "OpenAI-compatible base URL for OrcaRouter, used only when you manually pick an OrcaRouter model. The API key is stored in VS Code SecretStorage (command: *KarkeDikha: Set Up OrcaRouter (Cloud Models)*), never in settings."
        },
        "ollama-agent.cloudProviders": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "baseUrl": {
                "type": "string"
              },
              "accountId": {
                "type": "string"
              },
              "selectedModel": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "markdownDescription": "Non-secret configuration of connected cloud providers, keyed by provider id (managed from KarkeDikha Setup). API keys are never stored here; they live in VS Code SecretStorage."
        },
        "ollama-agent.skills.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Resolve a few relevant skills (built-in, yours in extension storage, and `.ollama-agent/skills` or `skills/` in a trusted workspace) per turn as short advisory guidance. Skills cannot grant permissions or bypass approvals."
        },
        "ollama-agent.repositoryGraph.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Index the workspace in the background (symbols, imports, tests) to help repository questions find the right files. Indexing is incremental and never blocks first use; source text, not the index, is what the model is shown."
        },
        "ollama-agent.repositoryGraph.maxFiles": {
          "type": "number",
          "default": 150000,
          "minimum": 1000,
          "markdownDescription": "Upper bound on files the repository graph tracks (a memory bound). Larger repositories keep the most relevant files and report partial coverage."
        },
        "ollama-agent.cloudSpendMode": {
          "type": "string",
          "enum": [
            "FREE_ONLY",
            "BUDGETED",
            "UNRESTRICTED"
          ],
          "default": "FREE_ONLY",
          "markdownDescription": "Hard cloud spend policy. `FREE_ONLY` (default) only ever uses models known to be free and never silently falls through to paid usage."
        },
        "ollama-agent.cloudAllowCredits": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Under `FREE_ONLY`, also allow models classified as trial or promotional (credit-limited, not recurring free)."
        },
        "ollama-agent.openRouterModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Named OpenRouter model id (e.g. `openai/gpt-5.6-sol`) required when OpenRouter is explicitly selected later. Empty refuses; no substitute. Independent of `#ollama-agent.cloudFallbackModel#`. API base is fixed to `https://openrouter.ai/api/v1` for this slice."
        },
        "ollama-agent.openRouterMaxUsd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "markdownDescription": "Positive finite USD spend cap required when OpenRouter is explicitly selected later. Missing, zero, or non-numeric refuses before any call. Independent of cloud-fallback settings."
        },
        "ollama-agent.contextWindow": {
          "type": "number",
          "default": 8192,
          "minimum": 512,
          "description": "Context window size in tokens. Vision requests automatically use at least 16384."
        },
        "ollama-agent.maxOutputTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Maximum tokens to generate per response. Set to 0 to use the provider's default."
        },
        "ollama-agent.temperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature (0.0 = deterministic, 2.0 = very random)."
        },
        "ollama-agent.requestTimeout": {
          "type": "number",
          "default": 300000,
          "minimum": 5000,
          "description": "Hard timeout for a single model request in milliseconds."
        },
        "ollama-agent.commandTimeout": {
          "type": "number",
          "default": 120000,
          "minimum": 1000,
          "description": "Maximum duration of a validation or tool command in milliseconds."
        },
        "ollama-agent.allowOutsideWorkspace": {
          "type": "boolean",
          "default": false,
          "description": "Allow agent to read/write files outside the workspace root"
        },
        "ollama-agent.maxIterations": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Maximum tool-call iterations per agent run"
        },
        "ollama-agent.maxToolOutputChars": {
          "type": "number",
          "default": 20000,
          "minimum": 1000,
          "description": "Maximum characters of tool output sent back to the model"
        },
        "ollama-agent.maxFileReadChars": {
          "type": "number",
          "default": 50000,
          "minimum": 1000,
          "description": "Maximum characters read from a single file"
        },
        "ollama-agent.maxTaskWallClock": {
          "type": "number",
          "default": 3600000,
          "minimum": 60000,
          "description": "Maximum active execution time per durable task in milliseconds. Paused and approval-wait time is excluded."
        },
        "ollama-agent.maxTaskModelCalls": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Maximum inference calls per durable task."
        },
        "ollama-agent.maxTaskToolCalls": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "Maximum tool executions per durable task."
        },
        "ollama-agent.maxTaskRepairAttempts": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "Maximum bounded repair cycles after required validation failures."
        },
        "ollama-agent.maxTaskOutputBytes": {
          "type": "number",
          "default": 5242880,
          "minimum": 1024,
          "description": "Maximum streamed model output bytes recorded for a durable task."
        },
        "ollama-agent.maxTaskNoProgressSteps": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "description": "Number of repeated progress fingerprints before the task is blocked as stuck."
        },
        "ollama-agent.requireApprovalForWrites": {
          "type": "boolean",
          "default": true,
          "description": "Require user approval before writing files"
        },
        "ollama-agent.requireApprovalForCommands": {
          "type": "boolean",
          "default": true,
          "description": "Require user approval before running commands"
        },
        "ollama-agent.enableAuditLog": {
          "type": "boolean",
          "default": true,
          "description": "Write audit log JSONL files to .ollama-agent/audit/"
        },
        "ollama-agent.enableCheckpoints": {
          "type": "boolean",
          "default": true,
          "description": "Create file checkpoints before mutations"
        },
        "ollama-agent.trustedAutonomyEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Explicitly opt into one persisted autonomous contract per Agent task. In-contract file changes and safe validation commands skip repetitive approval; hard denials and out-of-contract actions still stop or ask."
        },
        "ollama-agent.progressHeartbeatMs": {
          "type": "number",
          "default": 15000,
          "minimum": 5000,
          "description": "Interval for persisted progress heartbeats while a durable autonomous task is running."
        },
        "ollama-agent.sequentialRolesEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Run Supervisor, Planner, Implementer, Reviewer, and Validator sequentially for Agent tasks. Adds local model calls but improves handoffs and review discipline."
        },
        "ollama-agent.maxReviewerRepairPasses": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 3,
          "description": "Maximum bounded implementation repair turns triggered by blocking Reviewer findings."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "ollama-agent.openPreview",
          "when": "resourceExtname == .html || resourceExtname == .htm",
          "group": "navigation"
        }
      ]
    }
  },
