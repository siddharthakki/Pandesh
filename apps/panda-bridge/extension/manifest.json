{
  "manifest_version": 3,
  "name": "Pandesh Panda Bridge",
  "version": "0.1.0",
  "description": "Send a ChatGPT prompt to Pandesh on this PC, only when you choose to. Works on ChatGPT only.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Pandesh Panda Bridge", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
