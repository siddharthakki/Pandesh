    "CredentialMaterial",
    "PiDependencyImport",
    "CoreHealth",
    "CoreAuthenticatedApi",
    "DesktopCoreConnected",
    "MissingOllamaHandling",
    "UnrelatedProcessSurvivesAppStart",
    "UnauthorizedKillProcessRejected",
    "UnauthorizedPortControlRejected",
    "UnauthorizedPortCleanupRejected",
    "UnattendedMachineControlRejected",
    "UnauthorizedShellBypassRejected",
    "UnrelatedProcessSurvivesShutdown",
    "BuildIdentityConsistent",
    "UserDataAfterRun",
    "UninstallRemovesProgram",
    "UserDataAfterUninstall",
    "NetworkIsolation"
  ]
