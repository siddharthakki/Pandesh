graphify-out/
graphify-out/**
brag-output/
brag-output/**
brag-output-manual/
brag-output-manual/**
brag-output-codex-checkpoint/
brag-output-codex-checkpoint/**
brag-output-handoff.zip

# Stray packaged VSIX and JetBrains project files left at repo root.
.artifacts/
.artifacts/**

# Local dev convenience script and extra vitest configs, not extension content.
install-latest.ps1
vitest.golden.config.ts
vitest.platform.config.ts
vitest.webview-v2.config.ts

# Internal planning/history docs — design rationale for developers, not
# content the shipped extension reads (AGENTS.md-style lookups in
# src/platform/M14Platform.ts and src/intelligence/InstructionEngine.ts read
# the *user's* workspace root, never this repo's own copy).
AI_OS*.md
AGENTS.md
INVESTIGATION_NOTE.md

