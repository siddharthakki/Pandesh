{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "./out-core-tsc",
    "rootDir": "./core",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node"],
    "paths": {
      "@earendil-works/pi-ai/api/*": ["./node_modules/@earendil-works/pi-ai/dist/api/*"]
    }
  },
  "include": ["core/**/*.ts"],
  "exclude": ["node_modules", "out-core-tsc", "core/test/**"]
}
